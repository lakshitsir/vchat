{
  "version": 2,
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" },
        { "key": "Permissions-Policy", "value": "microphone=(self), autoplay=(self), wake-lock=(self)" }
      ]
    }
  ]
}
